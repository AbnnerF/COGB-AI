# Copie este arquivo para ".env" e preencha os valores

# Sua chave da API da Groq, gratuita (pegue em console.groq.com/keys)
GROQ_API_KEY=sua_chave_aqui

# Número do chip que o BOT vai usar (o número novo, não o seu pessoal)
# Formato: código do país + DDD + número, sem espaços nem símbolos (ex: 5565999999999)
BOT_NUMBER=5565999999999
